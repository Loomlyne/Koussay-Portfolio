# Copy to .env.local. Restart the dev server after changing these.

# Notion integration token (Internal integration, "Read content" + "Insert content")
NOTION_TOKEN=

# Projects database — the CMS for the carousel and work pages
NOTION_PROJECTS_DATABASE_ID=

# Bookings database — each form submit becomes a row
NOTION_BOOKINGS_DATABASE_ID=

# Optional. Same secret you set on the Notion webhook (or a Bearer token you pick).
# Webhook URL: https://YOUR_DOMAIN/api/revalidate
NOTION_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
# Must be a verified domain in Resend, e.g. "Koussay <hello@yourdomain.com>"
RESEND_FROM=

# Where new-booking alerts go (your inbox)
BOOKING_NOTIFY_EMAIL=
