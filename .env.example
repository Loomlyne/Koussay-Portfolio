# Copy to .env.local. Restart the dev server after changing these.

# Notion integration token (Internal integration, "Read content" + "Insert content")
# Insert is required so booking uploads attach to the Notion page, not just a filename.
NOTION_TOKEN=

# Bookings database — each form submit becomes a timed Notion Calendar event
NOTION_BOOKINGS_DATABASE_ID=

# Optional extra Notion database shown in Notion Calendar (blocked time, existing calls).
# Leave blank to use the bookings database as the only calendar.
NOTION_CALENDAR_DATABASE_ID=

# Resend
RESEND_API_KEY=
# Must be a verified domain in Resend, e.g. "Koussay <hello@yourdomain.com>"
RESEND_FROM=

# Where new-booking alerts go (your inbox)
BOOKING_NOTIFY_EMAIL=

# Optional. When set, each booking Notion page gets a short AI briefing
# under the confirmation email copy.
# Firecrawl reads the company site and searches the web.
FIRECRAWL_API_KEY=
# Gemini or OpenAI then writes the simple brief. Gemini can also search.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Higgsfield — authoring-time media generation only (scripts/, never the app).
# One key pair from https://console.higgsfield.ai, joined with a colon.
HF_CREDENTIALS=
# Endpoints default to the SDK's typed models; override only to try another.
# HIGGSFIELD_IMAGE_ENDPOINT=/v1/text2image/soul
# HIGGSFIELD_VIDEO_ENDPOINT=/v1/image2video/dop
# Overrides for the typed defaults, as JSON.
# Image defaults: width_and_height 2016x1344 (exactly 3:2), quality 1080p.
# HIGGSFIELD_IMAGE_PARAMS={"quality":"720p"}
# Video defaults: model dop-standard. Options: dop-lite, dop-turbo, dop-standard.
# HIGGSFIELD_VIDEO_PARAMS={"model":"dop-turbo"}

# R2 — media hosting. Write credentials are used by scripts/ only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public custom domain for the bucket, e.g. https://media.example.com
R2_PUBLIC_BASE=
