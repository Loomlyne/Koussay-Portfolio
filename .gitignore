# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Fonts are committed under public/fonts with their OFL licence.

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local output from scripts/generate-project-media.mjs --probe
.media-probe/

# playwright
/playwright-report/
/test-results/

# font sign-off screenshots (local only)
/.screens/

# third-party agent skills; skills-lock.json restores them
/.agents/skills/
